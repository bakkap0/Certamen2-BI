              <Commands>
                <Command>
                  <Text>CALCULATE;

CREATE MEMBER CURRENTCUBE.[Measures].[Ventas distintas] AS
    COUNT(NONEMPTY([Venta].[Venta].Levels(1).Members, {[Measures].[Unidades vendidas]})),
    FORMAT_STRING = '#,##0';

CREATE MEMBER CURRENTCUBE.[Measures].[Ventas con vendedor informado] AS
    IIF([Measures].[Ventas distintas] = 0, NULL,
        COALESCEEMPTY(([Measures].[Ventas distintas], [Vendedor].[Vendedor informado].&amp;[1]), 0)),
    FORMAT_STRING = '#,##0';

CREATE MEMBER CURRENTCUBE.[Measures].[Ticket promedio] AS
    DIVIDE([Measures].[Importe vendido], [Measures].[Ventas distintas]),
    FORMAT_STRING = '#,##0.0000';

CREATE MEMBER CURRENTCUBE.[Measures].[Porcentaje de ventas con vendedor informado] AS
    DIVIDE([Measures].[Ventas con vendedor informado], [Measures].[Ventas distintas]),
    FORMAT_STRING = '0.00%';

CREATE MEMBER CURRENTCUBE.[Measures].[Dias promedio de despacho] AS
    AVG(NONEMPTY([Venta].[Venta].Levels(1).Members, {[Measures].[Dias despacho base]}), [Measures].[Dias despacho base]),
    FORMAT_STRING = '0.000000';

CREATE MEMBER CURRENTCUBE.[Measures].[Importe mes anterior] AS
    IIF([Fecha de venta].[Calendario].CurrentMember.Level.Ordinal = 2,
        ([Measures].[Importe vendido], [Fecha de venta].[Calendario].CurrentMember.PrevMember),
        NULL),
    VISIBLE = 0;

CREATE MEMBER CURRENTCUBE.[Measures].[Crecimiento mensual de ventas] AS
    IIF(ISEMPTY([Measures].[Importe vendido]), NULL,
        DIVIDE([Measures].[Importe vendido] - [Measures].[Importe mes anterior], [Measures].[Importe mes anterior])),
    FORMAT_STRING = '0.00%';</Text>
                </Command>
              </Commands>
            </MdxScript>
          </MdxScripts>
        </Cube>
      </Cubes>
