            <component
              refId="Package\DFT Cargar DimFecha\Generar calendario"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Generar calendario"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">WITH Numeros AS (
    SELECT TOP (DATEDIFF(DAY, '20150101', '20181231') + 1)
           ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS n
    FROM sys.all_objects a CROSS JOIN sys.all_objects b
),
Fechas AS (
    SELECT CAST(DATEADD(DAY, n, '20150101') AS DATE) AS Fecha FROM Numeros
)
SELECT
    CAST(CONVERT(CHAR(8), Fecha, 112) AS INT)                       AS FechaKey,
    Fecha,
    CAST(YEAR(Fecha) AS SMALLINT)                                   AS Anio,
    CAST(CASE WHEN MONTH(Fecha) &lt;= 6 THEN 1 ELSE 2 END AS TINYINT)  AS Semestre,
    CAST(DATEPART(QUARTER, Fecha) AS TINYINT)                       AS Trimestre,
    CAST(MONTH(Fecha) AS TINYINT)                                   AS Mes,
    CAST(CHOOSE(MONTH(Fecha), N'Enero', N'Febrero', N'Marzo', N'Abril', N'Mayo', N'Junio',
         N'Julio', N'Agosto', N'Septiembre', N'Octubre', N'Noviembre', N'Diciembre')
         AS NVARCHAR(15))                                           AS NombreMes,
    CAST(DAY(Fecha) AS TINYINT)                                     AS Dia,
    CAST(DATEDIFF(DAY, '19000101', Fecha) % 7 + 1 AS TINYINT)       AS DiaSemana,
    CAST(CHOOSE(DATEDIFF(DAY, '19000101', Fecha) % 7 + 1,
         N'Lunes', N'Martes', N'Miércoles', N'Jueves', N'Viernes', N'Sábado', N'Domingo')
         AS NVARCHAR(15))                                           AS NombreDiaSemana
FROM Fechas
ORDER BY Fecha;</property>
                <property
