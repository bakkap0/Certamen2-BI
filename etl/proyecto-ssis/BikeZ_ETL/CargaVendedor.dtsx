              usesDispositions="true"
              version="6">
              <properties>
                <property
                  dataType="System.String"
                  description="Specifies the SQL statement that generates the lookup table."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT VendedorKey, EmpleadoID,
         Vendedor AS VendedorDW, Cargo AS CargoDW,
         Genero AS GeneroDW, EstadoCivil AS EstadoCivilDW,
         FechaNacimiento AS FechaNacimientoDW,
         FechaContratacion AS FechaContratacionDW,
         TerritorioAsignado AS TerritorioAsignadoDW
  FROM dbo.DimVendedor
  WHERE VendedorKey &gt; 0;</property>
                <property
                  dataType="System.String"
                  description="Specifies a SQL statement that uses parameters to generate the lookup table."
                  expressionType="Notify"
                  name="SqlCommandParam"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select * from (SELECT VendedorKey, EmpleadoID,
         Vendedor AS VendedorDW, Cargo AS CargoDW,
         Genero AS GeneroDW, EstadoCivil AS EstadoCivilDW,
         FechaNacimiento AS FechaNacimientoDW,
         FechaContratacion AS FechaContratacionDW,
         TerritorioAsignado AS TerritorioAsignadoDW
  FROM dbo.DimVendedor
  WHERE VendedorKey &gt; 0;) [refTable]
where [refTable].[EmpleadoID] = ?</property>
