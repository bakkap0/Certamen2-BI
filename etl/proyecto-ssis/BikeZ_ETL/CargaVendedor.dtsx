                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT e.EmpleadoID,
          e.Cargo,
          e.Genero,
          e.EstadoCivil,
          e.FechaNacimiento,
          e.FechaContratacion,
          t.Territorio AS TerritorioAsignado
