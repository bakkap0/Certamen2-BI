         Nombre AS NombreDW, Apellido AS ApellidoDW, NombreCompleto AS NombreCompletoDW
  FROM dbo.DimCliente
  WHERE ClienteKey &gt; 0;) [refTable]
where [refTable].[ClienteID] = ?</property>
