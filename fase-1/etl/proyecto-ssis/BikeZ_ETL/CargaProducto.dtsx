                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    p.ProductoID,
    p.Producto,
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(p.Color)), N''),
            N'Sin color informado'
        ) AS nvarchar(30)
    ) AS Color,
    p.CategoriaID,
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(c.Categoria)), N''),
            N'Sin categoría informada'
        ) AS nvarchar(50)
    ) AS Categoria
FROM dbo.Productos AS p
LEFT JOIN dbo.Categorias AS c
    ON c.CategoriaID = p.CategoriaID;</property>
